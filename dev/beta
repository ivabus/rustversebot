#!/usr/bin/env python3
"""Generate a text report from GachaBase or run the release tests."""
import argparse
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]


def cargo(*args):
    subprocess.run(["cargo", *args], cwd=ROOT, check=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("test", help="Release-тесты всего workspace")
    live = commands.add_parser("analyze", help="Новый отчёт через GachaBase и OpenAI в stdout")
    live.add_argument("url")
    args = parser.parse_args()

    # Cargo-installed CLI tools are not always on PATH on macOS.
    os.environ["PATH"] += os.pathsep + str(Path.home() / ".cargo/bin")
    cache = Path("/tmp/rustversebot-svg-release")
    if cache.is_dir() and cache.stat().st_uid == os.getuid():
        os.environ.setdefault("CARGO_TARGET_DIR", str(cache))
    if args.command == "analyze":
        cargo("run", "--quiet", "--release", "--locked", "-p", "rustverse_ai", "--", args.url)
        return
    cargo("test", "--release", "--workspace", "--locked")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
    except subprocess.CalledProcessError as error:
        sys.exit(error.returncode)
    except OSError as error:
        sys.exit(str(error))
