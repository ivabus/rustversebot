# Токен бота от @BotFather.
TELOXIDE_TOKEN=replace-with-telegram-bot-token

# Числовой Telegram ID администратора бота.
BOT_ADMIN_ID=123456789

# Локальная база libSQL. Относительный путь считается от рабочего каталога.
TURSO_DATABASE_URL=file:local.db

# Планировщик. Значения ниже совпадают с настройками по умолчанию.
BOT_SCHEDULER_INTERVAL_SECS=300
# Сколько секунд после контрольного времени можно отправить рейтинг.
BOT_CHECKPOINT_WINDOW_SECS=300
BOT_REQUEST_SPACING_MS=500
BOT_RETRY_ATTEMPTS=3
BOT_RETENTION_DAYS=90
# За сколько часов до официального старта открывается окно анонса сезона.
BOT_ANNOUNCEMENT_LEAD_HOURS=24

# Включает веб-панель. Для сетевого доступа нужен прокси с авторизацией.
# BOT_WEB_BIND=127.0.0.1:1234
# Секрет для входа в /admin. Сгенерировать: openssl rand -hex 32
# BOT_WEB_ADMIN_TOKEN=
# Публичный HTTPS-адрес панели для кнопки «История и график» в Telegram.
# BOT_PUBLIC_WEB_URL=https://zzz.example.com

# Ключ для вопросов об игре и генерации отчётов. Бот также читает ~/.openai.
# Лимит относится к новым отчётам в одном ручном сравнении.
# BETA_MAX_NEW_REPORTS=10
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.2-sol

# Трейсы ИИ в тестовый проект Langfuse Cloud. Регион по умолчанию — eu.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_REGION=eu

# Кэш загружаемых изображений и пути к программам рендеринга.
# IMAGE_CACHE_DIR=images
# TYPST_BIN=typst
# RESVG_BIN=resvg

# Фильтр журнала событий.
RUST_LOG=rustversebot=info
