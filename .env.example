# Required by teloxide. Obtain this token from @BotFather.
TELOXIDE_TOKEN=replace-with-telegram-bot-token

# Numeric Telegram user ID allowed to run administrative commands.
BOT_ADMIN_ID=123456789

# Local libSQL file (no separate server or auth token required).
TURSO_DATABASE_URL=file:local.db
# Required only when TURSO_DATABASE_URL points to remote Turso Cloud.
# TURSO_AUTH_TOKEN=replace-with-turso-auth-token

# Optional scheduler tuning. Defaults shown below.
BOT_SCHEDULER_INTERVAL_SECS=300
# A checkpoint is skipped permanently after this window expires.
BOT_CHECKPOINT_WINDOW_SECS=300
BOT_REQUEST_SPACING_MS=500
BOT_RETRY_ATTEMPTS=3
BOT_RETENTION_DAYS=90
# Upcoming Deadly Assault and Shiyu Defense cards are sent once during this
# many hours before their Nanoka start time. They are never sent after start.
BOT_ANNOUNCEMENT_LEAD_HOURS=24

# Optional read-only web dashboard. It is disabled when this variable is absent.
# Keep it on loopback unless a trusted reverse proxy provides access control.
# BOT_WEB_BIND=127.0.0.1:1234
# Public HTTPS base URL exposed by your reverse proxy. When set, result messages
# include an «История и график» button. Do not use a private localhost URL here.
# BOT_PUBLIC_WEB_URL=https://zzz.example.com

# Optional logging level.
RUST_LOG=rustversebot=info
