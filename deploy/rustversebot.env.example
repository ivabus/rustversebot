# Установите как /etc/rustversebot/rustversebot.env с владельцем root:root и правами 0600.
TELOXIDE_TOKEN=replace-with-telegram-bot-token
BOT_ADMIN_ID=123456789
TURSO_DATABASE_URL=file:/var/lib/rustversebot/local.db

BOT_WEB_BIND=127.0.0.1:8080
# Секрет для входа в /admin. Сгенерировать: openssl rand -hex 32
# BOT_WEB_ADMIN_TOKEN=

BOT_SCHEDULER_INTERVAL_SECS=300
BOT_CHECKPOINT_WINDOW_SECS=300
BOT_REQUEST_SPACING_MS=500
BOT_RETRY_ATTEMPTS=3
BOT_RETENTION_DAYS=90
BOT_ANNOUNCEMENT_LEAD_HOURS=24
# Ключ OpenAI для вопросов об игре и отчётов по бета- и релизной веткам.
# BETA_MAX_NEW_REPORTS=10
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.2-sol
# Трейсы всего бота. Укажите OTLP/HTTP адрес Tempo, Alloy или Grafana Cloud.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=
# RUSTVERSE_TRACE_AI_CONTENT=false

# Трейсы ИИ в тестовый проект Langfuse Cloud при отсутствии OTLP-адреса.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_REGION=eu
IMAGE_CACHE_DIR=/var/lib/rustversebot/image
RUST_LOG=rustversebot=info
