<style>
text {
	font-family: 'inpin hongmengti';
	fill: url(#Gradient3);
	stroke: url(#Gradient4);
}

.watermark {
	fill: url(#Gradient3);
	stroke: url(#Gradient4);
	stroke-width: 0.3;
	paint-order: stroke fill;
}

</style>

<defs>
	<linearGradient id="box-bg" x1="0" x2="0" y1="0" y2="1">
		<stop class="stop1" offset="0%" stop-color="#000" />
		<stop class="stop2" offset="15%" stop-color="#111111" />
		<stop class="stop2" offset="50%" stop-color="#282828" />
		<stop class="stop2" offset="85%" stop-color="#111111" />
		<stop class="stop3" offset="100%" stop-color="#000" />
	</linearGradient>
	<linearGradient id="box-stroke" x1="0" x2="1" y1="1" y2="0">
		<stop class="stop1" offset="0%" stop-color="#333" />
		<stop class="stop2" offset="50%" stop-color="#444" />
		<stop class="stop3" offset="100%" stop-color="#333" />
	</linearGradient>

	<pattern id="box-pattern" patternUnits="userSpaceOnUse" width="5" height="5">
		<circle cx="0" cy="0" r="0.5" stroke="#00000000" fill="#333" />
		<circle cx="0" cy="5" r="0.5" stroke="#00000000" fill="#333" />
		<circle cx="5" cy="0" r="0.5" stroke="#00000000" fill="#333" />
		<circle cx="5" cy="5" r="0.5" stroke="#00000000" fill="#333" />
		<circle cx="2.5" cy="2.5" r="0.5" stroke="#00000000" fill="#333" />
	</pattern>

	<linearGradient id="Gradient3" x1="0" y1="0" x2="0" y2="1">
		<stop class="stop1" offset="0%" stop-color="#ffffff" />
		<stop class="stop3" offset="100%" stop-color="#999999" />
	</linearGradient>

	<linearGradient id="Gradient4" x1="0" y1="0" x2="0" y2="1">
		<stop class="stop1" offset="0%" stop-color="#222" />
		<stop class="stop2" offset="50%" stop-color="#444" />
		<stop class="stop3" offset="100%" stop-color="#222" />
	</linearGradient>

	<linearGradient id="Gradient5" x1="0" y1="0" x2="0" y2="1">
		<stop class="stop1" offset="0%" stop-color="#222" />
		<stop class="stop2" offset="50%" stop-color="#444" />
		<stop class="stop3" offset="100%" stop-color="#222" />
	</linearGradient>
	<linearGradient id="Gradient6" x1="0" y1="0" x2="0" y2="1">
		<stop class="stop1" offset="0%" stop-color="#000" />
		<stop class="stop2" offset="50%" stop-color="#111" />
		<stop class="stop3" offset="100%" stop-color="#000" />
	</linearGradient>

	<linearGradient id="Mindscape" x1="0" y1="0" x2="1" y2="1">
		<stop class="stop1" offset="0%" stop-color="#fff" />
		<stop class="stop2" offset="50%" stop-color="#aaa" />
		<stop class="stop3" offset="100%" stop-color="#fff" />
	</linearGradient>

	<linearGradient id="art-grad-v" x1="0" y1="0" x2="0" y2="1">
		<stop offset="0%" stop-color="black" />
		<stop offset="5%" stop-color="white" />
		<stop offset="60%" stop-color="white" />
		<stop offset="90%" stop-color="black" />
	</linearGradient>
	<linearGradient id="art-grad-h" x1="0" y1="0" x2="1" y2="0">
		<stop offset="1%" stop-color="black" />
		<stop offset="10%" stop-color="white" />
		<stop offset="90%" stop-color="white" />
		<stop offset="99%" stop-color="black" />
	</linearGradient>

	<mask id="pre-art">
		<rect x="-5" y="-1005" width="200" height="1095" rx="17.5" ry="17.5" fill="white"></rect>
	</mask>

	<mask id="art">
		<rect width="200px" x="-5" y="-180" height="100%" fill="url(#art-grad-h)" mask="url(#pre-art)"  />
		<rect width="200px" x="-5" y="-180" height="100%" fill="url(#art-grad-v)" style="mix-blend-mode: multiply;" mask="url(#pre-art)" />
	</mask>

    <linearGradient id="Rating-S+" x1="0" y1="0" x2="0" y2="1">
		<stop class="stop1" offset="20%" stop-color="#7dbdf4" />
		<stop class="stop3" offset="50%" stop-color="#ffffff" />
		<stop class="stop1" offset="80%" stop-color="#7dbdf4" />

	</linearGradient>


			<linearGradient id="Rating-S" x1="0" y1="0" x2="800" y2="0" gradientUnits="userSpaceOnUse">

					<stop offset="0" stop-color="#c5810b" />

					<stop offset="0.14285714285714285" stop-color="#d5880c" />

					<stop offset="0.2857142857142857" stop-color="#e58f0e" />

					<stop offset="0.42857142857142855" stop-color="#f69611" />

					<stop offset="0.5714285714285714" stop-color="#ff9d10" />

					<stop offset="0.7142857142857143" stop-color="#ffa40b" />

					<stop offset="0.8571428571428571" stop-color="#ffac05" />

					<stop offset="1" stop-color="#ffb300" />

			</linearGradient>
	<!--<linearGradient id="Rating-S" x1="0" y1="0" x2="0" y2="1">
		<stop class="stop1" offset="0%" stop-color="#e4622b" />
		<stop class="stop3" offset="100%" stop-color="#f09637" />
	</linearGradient>-->
	<linearGradient id="Rating-A" x1="0" y1="0" x2="0" y2="1">
		<stop class="stop1" offset="0%" stop-color="#c83cf4" />
		<stop class="stop3" offset="100%" stop-color="#a81cd4" />
	</linearGradient>
	<linearGradient id="Rating-B" x1="0" y1="0" x2="0" y2="1">
		<stop class="stop1" offset="0%" stop-color="#ffffff" />
		<stop class="stop3" offset="100%" stop-color="#999999" />
	</linearGradient>

	<linearGradient id="Gradient7" x1="0" y1="0" x2="0" y2="1">
		<stop class="stop1" offset="0%" stop-color="#333" />
		<stop class="stop3" offset="100%" stop-color="#111" />
	</linearGradient>


	<clipPath id="square_avatar">
		<circle cx="25" cy="25" r="24" />
	</clipPath>

	<pattern id="background" width="4" height="4" patternUnits="userSpaceOnUse">
		<g fill='#111' fill-opacity='1.0' fill-rule='evenodd'><path d='M0 4L4 0H2L0 2M4 4V2L2 4'/></g>
	</pattern>



	<pattern y="-300" x="-{{total_score}}" id="bg-img-pat" width="512" height="200" patternUnits="userSpaceOnUse" patternTransform="rotate(-45)">
	<image width="512" href="rustverse-bundled-hollows.png" />
    </pattern>

    <mask id="bg-img">
		<rect fill="url(#bg-img-pat)" x="0" y="0" width="{{width}}" height="{{height}}" ></rect>
	</mask>

</defs>
