{% set width = 512 %}
{% set height = canvas_height %}
{% set boss_art_width = 25 %}
{% set card_width = width - 8 %}
{% set boss_art_x = card_width * (100 - boss_art_width) / 100 %}
{% set boss_art_pixel_width = card_width * boss_art_width / 100 %}
{% set total_score = height * 4 %}
{% macro format_num(value) %}
    {% set n = value | round | int %}
    {% if n >= 1000000 %}
        {{ n // 1000000 }} {{ "%03d"|format((n // 1000) % 1000) }} {{ "%03d"|format(n % 1000) }}
    {% elif n >= 1000 %}
        {{ n // 1000 }} {{ "%03d"|format(n % 1000) }}
    {% else %}
        {{ n }}
    {% endif %}
{% endmacro %}
<svg xmlns="http://www.w3.org/2000/svg" xmlns:IconMap="http://example.com" viewBox="0 0 {{width}} {{height}}" fill="black">
	{% include "defs.j2" %}

	<rect fill="black" x="0" y="0" width="{{width}}" height="{{height}}" />
	<rect fill="url(#background)" x="0" y="0" width="{{width}}" height="{{height}}"/>
	<rect fill="#222" mask="url(#bg-img)" x="0" y="0" width="{{width}}" height="{{height}}" />

	<image href="rustverse-bundled-da.webp" width="{{ width | int / 4 }}" x="{{ width | int * 3.0 / 8.0 }}" y="15" />
	<text x="{{width / 2}}" y="88" text-anchor="middle" font-size="11" style="stroke-width: 0.45;">Deadly Assault{% if begin_date %} · {{begin_date}}{% endif %}</text>

	<svg y="100">
		<svg>
			{% set buff_count = buffs | length %}
			{% for buff in buffs %}
			<svg x="{{4 + width / buff_count * loop.index0}}" width="{{width / buff_count - 8}}" height="{{buff_cards_height}}" style="overflow: visible;">
				<rect width="100%" height="100%" rx="17.5" ry="17.5" fill="url(#box-bg)" stroke="url(#box-stroke)" />
				<rect width="100%" height="100%" rx="17.5" ry="17.5" fill="url(#box-pattern)" stroke="url(#box-stroke)" />

				<text x="12" y="18" dominant-baseline="middle" font-size="10" style="stroke-width: 0.5;">{{ buff.title }}</text>
				<text x="12" y="34" font-size="6" style="stroke-width: 0.25;">
				{% for line in buff.desc | wrap_game_text(38) %}
			        <tspan x="{% if "·" in line %}6.5{% else %}11{% endif %}" dy="{% if loop.first %}0{% else %}1.5em{% endif %}">
			            {{ line | strip_all_tags | game_text }}
			        </tspan>
			    {% endfor %}
				</text>
			</svg>
			{% endfor %}
		</svg>

		<svg y="{{buff_cards_height + 10}}">
			{% for room in rooms %}
			<svg x="4" y="{{room.layout_y}}" width="{{width - 8}}" height="{{room.layout_height}}" style="overflow: visible;">
				<defs>
					{% if room.is_complex %}
					<linearGradient id="da-complex-stroke-{{loop.index0}}" x1="0" x2="1" y1="1" y2="0">
						<stop offset="0%" stop-color="#741022" />
						<stop offset="50%" stop-color="#a3162d" />
						<stop offset="100%" stop-color="#741022" />
					</linearGradient>
					{% endif %}
					<clipPath id="da-card-clip-{{loop.index0}}" clipPathUnits="userSpaceOnUse">
						<rect x="1" y="1" width="{{card_width - 2}}" height="{{room.layout_height - 2}}" rx="16.5" ry="16.5" />
					</clipPath>
					<linearGradient id="da-art-grad-{{loop.index0}}" gradientUnits="userSpaceOnUse" x1="{{boss_art_x}}" y1="0" x2="{{card_width}}" y2="0">
						<stop offset="0%" stop-color="white" stop-opacity="0" />
						<stop offset="22%" stop-color="white" stop-opacity="1" />
						<stop offset="90%" stop-color="white" stop-opacity="1" />
						<stop offset="100%" stop-color="white" stop-opacity="0" />
					</linearGradient>
					<mask id="da-art-mask-{{loop.index0}}" maskUnits="userSpaceOnUse" maskContentUnits="userSpaceOnUse" mask-type="alpha" x="{{boss_art_x}}" y="0" width="{{boss_art_pixel_width}}" height="{{room.layout_height}}">
						<rect x="{{boss_art_x}}" y="0" width="{{boss_art_pixel_width}}" height="{{room.layout_height}}" fill="url(#da-art-grad-{{loop.index0}})" />
					</mask>
				</defs>
				<rect width="100%" height="100%" rx="17.5" ry="17.5" fill="url(#box-bg)" stroke="url(#box-stroke)" />
				<rect width="100%" height="100%" rx="17.5" ry="17.5" fill="url(#box-pattern)" stroke="url(#box-stroke)" />

				<text x="12" y="18" dominant-baseline="middle" font-size="10" style="stroke-width: 0.5;">{{ room.name }}</text>
				{% set monster = room.monster %}
				<text x="12" y="37" font-size="8" style="stroke-width: 0.33;">
				<tspan>HP: {{ format_num(monster.hp) }}</tspan>
					<tspan dx="4">ATK: {{ format_num(monster.attack) }}</tspan>
					<tspan dx="4">DEF: {{ format_num(monster.defence) }}</tspan>
				</text>
				<text x="12" y="52.45" font-size="8" style="stroke-width: 0.33;">
				{% for weakness in monster.weaknesses %}
					{% if loop.first %}<tspan>Weakness: </tspan> {% endif %}
					<tspan dx="10">{{ weakness }}</tspan>
				{% endfor %}
				</text>

				<text x="200" y="52.45" font-size="8" style="stroke-width: 0.33;">
				{% for resistance in monster.resistances %}
					{% if loop.first %}<tspan>Resistance: </tspan> {% endif %}
					<tspan dx="10">{{ resistance }}</tspan>
				{% endfor %}
				</text>
				<image mask="url(#da-art-mask-{{loop.index0}})" clip-path="url(#da-card-clip-{{loop.index0}})" href="{{monster.image}}" x="{{100 - boss_art_width}}%" width="{{boss_art_width}}%" height="100%" preserveAspectRatio="xMidYMid slice" />
				{% if room.is_complex %}
				<rect x="1" y="1" width="{{card_width - 2}}" height="{{room.layout_height - 2}}" rx="16.5" ry="16.5" fill="none" stroke="url(#da-complex-stroke-{{loop.index0}})" stroke-width="1.5" />
				{% endif %}

				<text x="12" y="{{room.mechanics_y}}" font-size="7" style="stroke-width: 0.25;">
				{% for mechanic in room.mechanics %}
				{% for line in mechanic | strip_all_tags | wrap_game_text(82) %}
				        <tspan x="{% if "·" in line %}7.75{% else %}12{% endif %}" dy="1.35em">
							{{ line | strip_all_tags | game_text }}
				        </tspan>
				    {% endfor %}
				{% endfor %}
				</text>

			</svg>
			{% endfor %}
		</svg>

	</svg>

	<text class="watermark" text-anchor="end" dominant-baseline="middle" font-size="8" x="{{width-4}}" y="{{height - 4}}">nanoka.cc @rustversebot</text>
</svg>
