{% set width = 512 %}
{% set height = canvas_height %}
{% set boss_art_width = 30 %}
{% set card_width = width - 8 %}
{% set boss_art_x = card_width * (100 - boss_art_width) / 100 %}
{% set boss_art_pixel_width = card_width * boss_art_width / 100 %}
{% set total_score = height * 4 %}
{% macro format_num(value) %}
    {% set n = value | round | int %}
    {% if n >= 1000000 %}
        {{ n // 1000000 }} {{ "%03d"|format((n // 1000) % 1000) }} {{ "%03d"|format(n % 1000) }}
    {% elif n >= 1000 %}
        {{ n // 1000 }} {{ "%03d"|format(n % 1000) }}
    {% else %}
        {{ n }}
    {% endif %}
{% endmacro %}
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {{width}} {{height}}" fill="black">
	{% include "defs.j2" %}

	<rect fill="black" width="{{width}}" height="{{height}}" />
	<rect fill="url(#background)" width="{{width}}" height="{{height}}" />
	<rect fill="#222" mask="url(#bg-img)" width="{{width}}" height="{{height}}" />

	<image href="rustverse-bundled-shiyu.webp" width="92" x="210" y="10" />
	<text x="{{width / 2}}" y="{{91 + title_top_gap}}" text-anchor="middle" font-size="11" style="stroke-width: 0.45;">
		{{ name }} · {{ id }} · Stage {{ stage_num }}{% if begin_date %} · {{begin_date}}{% endif %}
	</text>
	<text x="{{width / 2}}" y="{{106 + title_top_gap}}" text-anchor="middle" font-size="7.5" style="stroke-width: 0.3;">
		S {{ format_num(s_rank_goal) }} · A {{ format_num(a_rank_goal) }} · B {{ format_num(b_rank_goal) }}
		{% if score_cap %} · Score cap {{ format_num(score_cap) }}{% endif %}
	</text>

	<svg y="{{rooms_start}}">
		{% for room in rooms %}
		<svg x="4" y="{{room.layout_y}}" width="{{width - 8}}" height="{{room.layout_height}}" style="overflow: visible;">
			<defs>
				<clipPath id="shiyu-card-clip-{{loop.index0}}" clipPathUnits="userSpaceOnUse">
					<rect x="0" y="0" width="{{card_width}}" height="{{room.layout_height}}" rx="17.5" ry="17.5" />
				</clipPath>
				<linearGradient id="shiyu-art-grad-{{loop.index0}}" gradientUnits="userSpaceOnUse" x1="{{boss_art_x}}" y1="0" x2="{{card_width}}" y2="0">
					<stop offset="0%" stop-color="white" stop-opacity="0" />
					<stop offset="22%" stop-color="white" stop-opacity="1" />
					<stop offset="90%" stop-color="white" stop-opacity="1" />
					<stop offset="100%" stop-color="white" stop-opacity="0" />
				</linearGradient>
				<mask id="shiyu-art-mask-{{loop.index0}}" maskUnits="userSpaceOnUse" maskContentUnits="userSpaceOnUse" mask-type="alpha" x="{{boss_art_x}}" y="0" width="{{boss_art_pixel_width}}" height="{{room.layout_height}}">
					<rect x="{{boss_art_x}}" y="0" width="{{boss_art_pixel_width}}" height="{{room.layout_height}}" fill="url(#shiyu-art-grad-{{loop.index0}})" />
				</mask>
			</defs>
			<rect width="100%" height="100%" rx="17.5" ry="17.5" fill="url(#box-bg)" stroke="url(#box-stroke)" />
			<rect width="100%" height="100%" rx="17.5" ry="17.5" fill="url(#box-pattern)" stroke="url(#box-stroke)" />

			<text x="12" y="20" dominant-baseline="middle" font-size="11" style="stroke-width: 0.45;">{{ room.name }}</text>
			<text x="125" y="20" dominant-baseline="middle" font-size="7" style="stroke-width: 0.28;">{{ room.waves_num }} waves</text>

			<text x="12" y="39" font-size="9" style="stroke-width: 0.36;">{{ room.main_monster.name }}</text>
			<text x="12" y="53" font-size="7" style="stroke-width: 0.28;">
				<tspan>HP: {{ format_num(room.main_monster.hp) }}</tspan>
				<tspan dx="7">ATK: {{ format_num(room.main_monster.attack) }}</tspan>
				<tspan dx="7">DEF: {{ format_num(room.main_monster.defence) }}</tspan>
			</text>
			{% if room.weaknesses %}
			<text x="12" y="67" font-size="8" style="stroke-width: 0.33;">
				<tspan>Weakness:</tspan>
				{% for weakness in room.weaknesses %}<tspan dx="10">{{ weakness }}</tspan>{% endfor %}
			</text>
			{% endif %}
			{% if room.main_monster.resistances %}
			<text x="200" y="67" font-size="8" style="stroke-width: 0.33;">
				<tspan>Resistance:</tspan>
				{% for resistance in room.main_monster.resistances %}<tspan dx="10">{{ resistance }}</tspan>{% endfor %}
			</text>
			{% endif %}

			{% if room.other_monsters %}
			<text x="12" y="84" font-size="6.7" style="stroke-width: 0.25;">
				<tspan x="12">Other enemies:</tspan>
				{% for monster in room.other_monsters %}
				<tspan x="18" dy="1.45em">· {{ monster.name }} · HP {{ format_num(monster.hp) }}</tspan>
				{% endfor %}
			</text>
			{% endif %}

			{% if room.mechanics %}
			<text x="12" y="{{room.mechanics_y}}" font-size="7.2" style="stroke-width: 0.28;">Room mechanics:</text>
			<text x="12" y="{{room.mechanics_y + 4}}" font-size="6.2" style="stroke-width: 0.23;">
				{% for mechanic in room.mechanics %}
					{% for paragraph in mechanic | strip_all_tags | paragraphs %}
						{% set has_bullet = paragraph and paragraph[0] == "·" %}
						{% if has_bullet %}{% set paragraph = paragraph[1:] | trim %}{% endif %}
						{% for line in paragraph | wrap_game_text(mechanics_wrap_width) %}
						{% if has_bullet and loop.first %}<tspan x="7.5" dy="1.35em">·</tspan>{% endif %}
						<tspan x="12" dy="{% if has_bullet and loop.first %}0{% else %}1.35em{% endif %}">
							{{ line | game_text }}
						</tspan>
						{% endfor %}
					{% endfor %}
				{% endfor %}
			</text>
			{% endif %}

			<image mask="url(#shiyu-art-mask-{{loop.index0}})" clip-path="url(#shiyu-card-clip-{{loop.index0}})" href="{{room.main_monster.image}}" x="{{100 - boss_art_width}}%" width="{{boss_art_width}}%" height="100%" preserveAspectRatio="xMidYMid slice" />
		</svg>
		{% endfor %}
	</svg>

	<text class="watermark" text-anchor="end" dominant-baseline="middle" font-size="8" x="{{width-4}}" y="{{height - 4}}">nanoka.cc @rustversebot</text>
</svg>
