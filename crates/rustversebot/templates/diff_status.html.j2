{% extends "prompt_status.html.j2" %}
{% block heading %}<b>Создаю дифф между версиями</b>{% if activity.previous and activity.current %} · <code>{{ activity.previous[:64] }}</code> → <code>{{ activity.current[:64] }}</code>{% endif %}
{% if activity.character %}<b>{{ activity.character[:100] }}</b>
{% endif %}{% endblock %}
{% block stage -%}
{% if activity.stage == "prepare" %}Подбираю ревизии…
{%- elif activity.stage == "render" %}Рендеринг карточки…
{%- elif activity.stage == "send" %}Отправляю карточки…
{%- elif p.stage == "writing" %}Пишу отчёт…
{%- elif p.stage == "compacting" or p.research_status or p.stage == "researching" %}{{ super() }}
{%- else %}Сравниваю данные GachaBase…
{%- endif %}{% endblock %}
